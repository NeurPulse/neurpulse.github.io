---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR, RESEARCH_INTERESTS } from '../../consts';
import { compareCategories } from '../../utils/post-order';
import { getTopicHref } from '../../data/topics';

const notes = await getCollection('notes', ({ data }) => !data.draft);
const categories = [...new Set(notes.map((post) => post.data.category))].sort(compareCategories);
const topics = RESEARCH_INTERESTS.map((name) => ({
  name,
  href: categories.includes(name) ? getTopicHref(name) : null,
}));
const education = [
  {
    school: '西安邮电大学',
    detail: '计算机科学与技术 · 学术型硕士（在读）',
    start: '2026-09',
    end: null,
  },
  {
    school: '太原工业学院',
    detail: '计算机科学与技术 · 本科',
    start: '2022-09',
    end: '2026-06',
  },
];
---

<BaseLayout title="关于我" description={`${AUTHOR}的教育背景、研究方向与联系方式。`}>
  <div class="about-page">
    <h1>关于我</h1>
    <p class="page-intro">{AUTHOR}，计算机科学与技术研究生。</p>

    <div class="about-sections">
      <section class="about-education-section" aria-labelledby="about-education-title">
        <h2 id="about-education-title">教育背景</h2>
        <ul class="about-education">
          {education.map((entry) => (
            <li>
              <h3>{entry.school}</h3>
              <p class="about-period">
                <time datetime={entry.start}>{entry.start.replace('-', '.')}</time>
                {' – '}
                {entry.end ? <time datetime={entry.end}>{entry.end.replace('-', '.')}</time> : '至今'}
              </p>
              <p class="about-degree">{entry.detail}</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="about-topics-title">
        <h2 id="about-topics-title">研究方向</h2>
        <ul class="about-topics">
          {topics.map((topic) => (
            <li>{topic.href ? <a href={topic.href}>{topic.name}</a> : <span>{topic.name}</span>}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="about-contact-title">
        <h2 id="about-contact-title">联系方式</h2>
        <dl class="about-contacts">
          <div>
            <dt>邮箱</dt>
            <dd><a href="mailto:2512388681@qq.com">2512388681@qq.com</a></dd>
          </div>
          <div>
            <dt>GitHub</dt>
            <dd><a href="https://github.com/NeurPulse">@NeurPulse</a></dd>
          </div>
        </dl>
      </section>
    </div>

    <p class="about-skills">
      <strong>技能与工具：</strong>Python（PyTorch / NumPy / Pandas）、C++；Git、Linux、LaTeX；<span>英语：CET-4。</span>
    </p>
  </div>
</BaseLayout>
