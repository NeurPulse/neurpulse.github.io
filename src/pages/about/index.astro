---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR, RESEARCH_INTERESTS } from '../../consts';
---

<BaseLayout title="关于">
  <h1>关于我</h1>
  <div class="about-grid">
    <p>
      我是{AUTHOR}，计算机科学与技术专业硕士研究生。
      欢迎关注我的博客，也欢迎邮件交流。
    </p>

    <h2>研究方向</h2>
    <ul>
      {RESEARCH_INTERESTS.map((item) => <li>{item}</li>)}
    </ul>

    <h2>教育背景</h2>
    <ul>
      <li>2026.09 – 至今：西安邮电大学，计算机科学与技术，学硕（在读研一）</li>
      <li>2022.09 – 2026.06：太原工业学院，计算机科学与技术专业，本科</li>
    </ul>

    <h2>技能</h2>
    <ul>
      <li>编程：Python（PyTorch / NumPy / Pandas）、C++</li>
      <li>工具：Git、Linux、LaTeX</li>
      <li>英语：CET-4</li>
    </ul>

    <h2>联系方式</h2>
    <ul>
      <li>邮箱：2512388681@qq.com</li>
      <li>GitHub：<a href="https://github.com/NeurPulse">@NeurPulse</a></li>
    </ul>
  </div>
</BaseLayout>
