---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { compareCategories, compareReadingOrder } from '../../utils/post-order';
import { TOPIC_GUIDES, getTopicId } from '../../data/topics';

const posts = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  compareReadingOrder
);

// 按专题分组，保留各专题的学习顺序。
const byCategory = new Map<string, typeof posts>();
for (const p of posts) {
  const list = byCategory.get(p.data.category) ?? [];
  list.push(p);
  byCategory.set(p.data.category, list);
}

const categories = [...byCategory.entries()].sort(([a], [b]) =>
  compareCategories(a, b)
);
---

<BaseLayout title="学习笔记">
  <h1>学习笔记</h1>
  <p class="page-intro">
    共 {posts.length} 篇笔记，分为 {categories.length} 个专题。选择一个专题，从第 1 篇开始按顺序阅读。
  </p>
  <nav id="topic-filters" class="category-jumps" aria-label="笔记专题">
    <a href="#topic-overview" data-topic-filter="topic-overview" hidden>专题概览</a>
    {
      categories.map(([category, list]) => (
        <a href={`#${getTopicId(category)}`} data-topic-filter={getTopicId(category)}>
          {category}<span>{list.length}</span>
        </a>
      ))
    }
  </nav>
  <p id="topic-status" class="filter-status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
  <section id="topic-overview" class="topic-overview" aria-label="专题概览" hidden>
    {
      categories.map(([category, list]) => (
        <article class="topic-summary">
          <h2><a href={`#${getTopicId(category)}`}>{category}</a></h2>
          <p>{list.length} 篇 · 按学习顺序</p>
          {TOPIC_GUIDES[category] && <p class="topic-summary-description">{TOPIC_GUIDES[category].summary}</p>}
          <p class="topic-first">从「{list[0].data.title}」开始</p>
          <a href={`#${getTopicId(category)}`} aria-label={`查看${category}专题的导读与 ${list.length} 篇笔记`}>导读与目录 →</a>
        </article>
      ))
    }
  </section>
  {
    categories.map(([category, list]) => (
      <section
        id={getTopicId(category)}
        class="note-category"
        data-note-category={category}
        data-post-count={list.length}
      >
        {TOPIC_GUIDES[category]?.aliases?.map((alias) => (
          <span id={alias} data-topic-alias={getTopicId(category)} hidden></span>
        ))}
        <div class="section-head">
          <h2>
            {category}
            <span class="count">{list.length} 篇 · 按学习顺序</span>
          </h2>
        </div>
        {TOPIC_GUIDES[category] && (
          <div class="topic-guide">
            <p class="topic-guide-summary">{TOPIC_GUIDES[category].summary}</p>
            <dl class="topic-guide-facts">
              <div><dt>适合谁</dt><dd>{TOPIC_GUIDES[category].audience}</dd></div>
              <div><dt>前置知识</dt><dd>{TOPIC_GUIDES[category].prerequisites}</dd></div>
              <div><dt>学习目标</dt><dd>{TOPIC_GUIDES[category].outcome}</dd></div>
            </dl>
            <nav class="topic-reading-path" aria-label={`${category}的建议阅读路线`}>
              <p>建议路线</p>
              <ol>
                {TOPIC_GUIDES[category].steps.map((step) => (
                  <li><a href={`/notes/${step.postId}/`}>{step.label}</a></li>
                ))}
              </ol>
            </nav>
          </div>
        )}
        {list.map((p, index) => (
          <div class="ordered-post">
            <span class="order-number">{String(index + 1).padStart(2, '0')}</span>
            <PostCard post={p} base="/notes" />
          </div>
        ))}
      </section>
    ))
  }
</BaseLayout>

<script>
  const overview = document.getElementById('topic-overview');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-note-category]')];
  const filters = [...document.querySelectorAll<HTMLAnchorElement>('[data-topic-filter]')];
  const status = document.getElementById('topic-status');

  function showTopic(scrollToFilters = false) {
    if (!overview) return;
    const alias = document.getElementById(location.hash.slice(1))?.dataset.topicAlias;
    const selected = sections.find((section) => `#${section.id}` === (alias ? `#${alias}` : location.hash));
    const selectedId = selected?.id ?? overview.id;

    overview.hidden = !!selected;
    sections.forEach((section) => { section.hidden = section !== selected; });
    filters.forEach((link) => {
      link.hidden = false;
      if (link.dataset.topicFilter === selectedId) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
    if (status) {
      status.hidden = false;
      status.textContent = selected
        ? `${selected.dataset.noteCategory} · ${selected.dataset.postCount} 篇笔记，按学习顺序排列`
        : '选择一个专题，查看完整阅读目录。';
    }

    // 保留专题锚点和前进/后退，同时让筛选入口留在视野内，便于再次切换。
    if (scrollToFilters) {
      requestAnimationFrame(() => {
        document.getElementById('topic-filters')?.scrollIntoView({ block: 'start' });
      });
    }
  }

  showTopic(!!location.hash);
  window.addEventListener('hashchange', () => showTopic(true));
</script>
