---
interface NavPost {
  id: string;
  title: string;
}

interface Props {
  prev: NavPost | null;
  next: NavPost | null;
  base: '/notes' | '/research';
  heading?: string;
}

const { prev, next, base, heading = '继续学习本专题' } = Astro.props;
---

{
  (prev || next) && (
    <div class="post-nav-wrap">
      <div class="post-nav-heading">{heading}</div>
      <nav class="post-nav" aria-label={`${heading}：上一篇和下一篇`}>
        {prev ? (
          <a href={`${base}/${prev.id}/`}>
            <span class="nav-label">← 上一篇</span>
            <span class="nav-title">{prev.title}</span>
          </a>
        ) : (
          <span class="spacer" />
        )}
        {next ? (
          <a href={`${base}/${next.id}/`} class="next">
            <span class="nav-label">下一篇 →</span>
            <span class="nav-title">{next.title}</span>
          </a>
        ) : (
          <span class="spacer" />
        )}
      </nav>
    </div>
  )
}
