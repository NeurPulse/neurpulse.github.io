---
interface SeriesPost {
  id: string;
  title: string;
}

interface Props {
  posts: SeriesPost[];
  currentId: string;
  category: string;
}

const { posts, currentId, category } = Astro.props;
const currentIndex = posts.findIndex((post) => post.id === currentId);
---

<nav class="series-nav" aria-label={`${category}专题阅读顺序`}>
  <div class="series-nav-head">
    <div>
      <span class="series-kicker">专题阅读</span>
      <strong>{category}</strong>
    </div>
    <span class="series-progress">
      {currentIndex + 1} / {posts.length}
    </span>
  </div>
  <ol class="series-list" data-series-list>
    {
      posts.map((post, index) => (
        <li
          class:list={[{ current: post.id === currentId }]}
          data-series-current={post.id === currentId ? 'true' : undefined}
        >
          <a
            href={`/notes/${post.id}/`}
            aria-current={post.id === currentId ? 'page' : undefined}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            {post.title}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  function centerCurrentSeriesItems() {
    const lists = document.querySelectorAll<HTMLElement>('[data-series-list]');

    lists.forEach((list) => {
      const current = list.querySelector<HTMLElement>('[data-series-current="true"]');
      if (!current || list.clientHeight === 0) return;

      const targetTop =
        current.offsetTop - list.clientHeight / 2 + current.offsetHeight / 2;
      list.scrollTop = Math.max(0, targetTop);
    });
  }

  function scheduleCentering() {
    requestAnimationFrame(centerCurrentSeriesItems);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleCentering, { once: true });
  } else {
    scheduleCentering();
  }

  window.addEventListener('pageshow', scheduleCentering);

  document.querySelectorAll<HTMLDetailsElement>('.series-mobile').forEach((details) => {
    details.addEventListener('toggle', () => {
      if (details.open) scheduleCentering();
    });
  });
</script>
